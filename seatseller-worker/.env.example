# Copy to .env, fill in values, then `npm start`.

# SeatSeller B2B credentials
SEATSELLER_URL=https://in3.seatseller.travel
SEATSELLER_USER=8853391184
SEATSELLER_PASS=Cheap@8853

# HTTP server settings
PORT=4001
# Shared secret — main api/index.js sends this in X-Worker-Token header.
# Change to a long random string for production.
WORKER_TOKEN=changeme_long_random_string

# Optional residential proxy (Bright Data / Smartproxy India endpoint)
# Leave blank to use the VPS's own IP (works for most cases).
PROXY_SERVER=
PROXY_USER=
PROXY_PASS=

# Run with a visible browser for debugging? Default headless.
HEADLESS=true

# Session refresh interval (ms) — Akamai cookies stale after ~30 min
SESSION_REFRESH_MS=1500000
