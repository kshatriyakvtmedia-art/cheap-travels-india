# =====================================================
# Cheap Travels India — environment configuration
# Copy to .env for production, .env.local for dev
# NEVER commit .env or .env.local — both are gitignored
# =====================================================

# Site
NEXT_PUBLIC_SITE_NAME="Cheap Travels India"
NEXT_PUBLIC_SITE_URL="https://cheaptravels.in"

# Commission engine (percentages)
PROVIDER_COMMISSION_PCT=20
OUR_MARGIN_PCT=15
CUSTOMER_DISCOUNT_PCT=5

# Static UPI VPA
UPI_VPA="cheaptravels@upi"
UPI_PAYEE_NAME="Cheap Travels India"

# ---- Provider agent credentials ----
LAXMI_LOGIN_URL="https://lxmi.laxmiholidays.com/"
LXMI_USERNAME=""
LXMI_PASSWORD=""
RDLH_PORTAL_URL="https://rdlh.ticketsimply.com"
RDLH_USERNAME=""
RDLH_PASSWORD=""

# ---- Core secrets (generate with: openssl rand -hex 32) ----
DATABASE_URL=""
ENCRYPTION_KEY=""
JWT_SECRET=""
RAZORPAY_KEY=""
RAZORPAY_SECRET=""

# ---- WhatsApp Cloud API (Meta / graph.facebook.com) ----
# Used for OTP delivery.
# Setup steps:
#   1. Go to Meta Business Manager → WhatsApp → API Setup
#   2. Copy your permanent access token → WHATSAPP_API_TOKEN
#   3. Copy your Phone Number ID     → WHATSAPP_PHONE_NUMBER_ID
#   4. Create an APPROVED message template named exactly as WHATSAPP_OTP_TEMPLATE
#      Category: AUTHENTICATION  Language: English (en)
#      Body text: "Your Cheap Travels India OTP is {{1}}. Valid for 5 minutes. Do not share."
# Leave blank to use console-log mock (local dev only)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE="cheap_travels_otp"

# ---- WhatsApp ticket delivery (AiSensy / Wati) ----
# Separate channel used for sending confirmed booking tickets
WHATSAPP_API_URL="https://backend.aisensy.com/campaign/t1/api/v2"
WHATSAPP_API_KEY=""
WHATSAPP_TEMPLATE_NAME="ticket_confirmation"

# ---- Email (SMTP) ----
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Cheap Travels India <support@cheaptravels.in>"
