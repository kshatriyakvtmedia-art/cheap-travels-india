# =====================================================
# Cheap Travels India — environment configuration
# Copy to .env.local for development, .env for production
# =====================================================

# Site
NEXT_PUBLIC_SITE_NAME="Cheap Travels India"
NEXT_PUBLIC_SITE_URL="https://cheaptravels.in"
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Database (SQLite path — gets created automatically)
DB_PATH="./data/cheaptravels.db"

# Commission engine (percentages — what provider gives you, what you keep, what you discount)
PROVIDER_COMMISSION_PCT=20
OUR_MARGIN_PCT=15
CUSTOMER_DISCOUNT_PCT=5

# Static UPI VPA (the QR is generated to this address)
UPI_VPA="cheaptravels@upi"
UPI_PAYEE_NAME="Cheap Travels India"

# ---- Laxmi Holidays agent credentials ----
# Leave blank to use mock data (good for local dev / first deploy)
LAXMI_LOGIN_URL="https://lxmi.laxmiholidays.com/"
LAXMI_USER=""
LAXMI_PASS=""

# Add more providers as you onboard them
# PROVIDER2_LOGIN_URL=""
# PROVIDER2_USER=""
# PROVIDER2_PASS=""

# ---- WhatsApp (via AiSensy or Wati) ----
# Leave blank to skip WA delivery (will log to console)
WHATSAPP_API_URL="https://backend.aisensy.com/campaign/t1/api/v2"
WHATSAPP_API_KEY=""
WHATSAPP_TEMPLATE_NAME="ticket_confirmation"

# ---- Email (SMTP) ----
# Leave blank to skip email
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Cheap Travels India <support@cheaptravels.in>"
